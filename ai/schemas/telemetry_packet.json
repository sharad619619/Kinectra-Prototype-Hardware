{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KinectraTelemetryPacket",
  "type": "object",
  "required": [
    "session_id",
    "timestamp_ms",
    "sport",
    "joint_angles",
    "imu_telemetry",
    "action_state"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "sport": {
      "type": "string",
      "enum": ["bowling", "batting", "basketball", "badminton"]
    },
    "joint_angles": {
      "type": "object",
      "required": ["elbow_angle", "knee_angle", "spine_tilt", "shoulder_alignment"],
      "properties": {
        "elbow_angle": { "type": "number", "minimum": 0, "maximum": 180 },
        "knee_angle": { "type": "number", "minimum": -1, "maximum": 180 },
        "spine_tilt": { "type": "number", "minimum": 0, "maximum": 90 },
        "shoulder_alignment": { "type": "number", "minimum": 0, "maximum": 90 }
      }
    },
    "imu_telemetry": {
      "type": "object",
      "required": ["accel_g", "gyro_dps", "impact_detected"],
      "properties": {
        "accel_g": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" },
            "mag": { "type": "number" }
          }
        },
        "gyro_dps": {
          "type": "object",
          "properties": {
            "yaw": { "type": "number" },
            "pitch": { "type": "number" },
            "roll": { "type": "number" }
          }
        },
        "impact_detected": { "type": "boolean" }
      }
    },
    "action_state": {
      "type": "object",
      "required": ["phase", "hand_speed_normalized", "is_action_active"],
      "properties": {
        "phase": { "type": "string" },
        "hand_speed_normalized": { "type": "number", "minimum": 0 },
        "is_action_active": { "type": "boolean" }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KinectraSessionReport",
  "type": "object",
  "required": [
    "session_id",
    "athlete_name",
    "sport",
    "total_actions_analyzed",
    "scores",
    "strengths",
    "biomechanical_risks",
    "recommended_drills"
  ],
  "properties": {
    "session_id": { "type": "string" },
    "athlete_name": { "type": "string" },
    "sport": { "type": "string" },
    "duration_seconds": { "type": "integer" },
    "total_actions_analyzed": { "type": "integer" },
    "scores": {
      "type": "object",
      "required": ["overall_technique", "posture", "alignment", "stability", "efficiency"],
      "properties": {
        "overall_technique": { "type": "number", "minimum": 0, "maximum": 100 },
        "posture": { "type": "number", "minimum": 0, "maximum": 100 },
        "alignment": { "type": "number", "minimum": 0, "maximum": 100 },
        "stability": { "type": "number", "minimum": 0, "maximum": 100 },
        "efficiency": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "strengths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "biomechanical_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk_factor", "severity", "anatomical_joint", "remediation"],
        "properties": {
          "risk_factor": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "moderate", "high"] },
          "anatomical_joint": { "type": "string" },
          "remediation": { "type": "string" }
        }
      }
    },
    "recommended_drills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["drill_name", "focus_area", "reps_sets", "description"],
        "properties": {
          "drill_name": { "type": "string" },
          "focus_area": { "type": "string" },
          "reps_sets": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
